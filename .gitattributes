# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.py text
*.md text
*.txt text
*.yaml text
*.yml text
*.csv text
*.json text

# Declare binary files
*.inp binary
*.png binary
*.jpg binary
*.pdf binary
*.pkl binary
*.npz binary
*.npy binary
*.gz binary
*.xlsx binary

# Frozen scientific assets retain their recorded byte hashes on every platform.
data/reference/** -text -whitespace
data/frozen/** -text -whitespace
source_data/** -text -whitespace
reproducibility/** -text -whitespace
